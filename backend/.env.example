# OpenAI-compatible LLM endpoint (Meta Muse Spark by default).
# Confirm base URL + model ID in the Meta Developer Console. Do NOT use a "contributor" model ID.
LLM_BASE_URL=https://api.meta.ai/v1
LLM_API_KEY=your-key-here
LLM_MODEL=muse-spark-1.3

# Optional: Semantic Scholar API key (raises rate limits). Leave blank to use the shared pool.
S2_API_KEY=
